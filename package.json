{
  "name": "@dsh-prism/dsh-concierge-ui",
  "version": "0.1.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist/",
    "!dist/*.test.*",
    "!dist/*.tsbuildinfo",
    "!dist/*probe.*"
  ],
  "engines": {
    "node": ">=24.9.0",
    "dsh": "0.2.3-alpha.2"
  },
  "publishConfig": {
