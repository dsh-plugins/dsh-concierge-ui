{
  "name": "@dsh-prism/dsh-concierge-ui",
  "description": "Configure Prism in the DSH web app, chat across projects and inspect delegated tasks.",
  "version": "0.1.2",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./client": "./dist/client/dsh.js"
  },
  "files": [
    "dist/",
    "!dist/*.test.*",
    "!dist/*.tsbuildinfo",
    "!dist/*probe.*",
    "locale/*.json",
    "icon.svg",
    "README.zh_CN.md",
    "cordis.patch.yml"
  ],
  "engines": {
    "node": ">=24.9.0",
    "dsh": "0.2.3-alpha.2"
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "4.2.0-alpha.1",
    "@deepseek-ai/dsh-host-webserver": "0.2.3-alpha.2",
    "@dsh-prism/dsh-orchestrator": "^0.1.1",
    "@deepseek-ai/dsh-settings": "0.2.3-alpha.2"
  },
  "scripts": {
    "build": "tsc -b tsconfig.release.json && npm run bundle",
    "bundle": "node scripts/bundle.mjs",
    "test": "node --test test/*.test.mjs"
  },
  "dependencies": {
    "@arco-design/web-react": "2.66.18",
    "@deepseek-ai/dsh-client-ui-theme": "0.2.3-alpha.2",
    "@dsh-plugin/dsh-loader": "2.0.0-dev.45752173879",
    "@dsh-plugin/dsh-ui-components": "0.1.0-dev.45544484650",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "qrcode": "1.5.4",
    "react-markdown": "10.1.0",
    "remark-breaks": "4.0.0",
    "remark-gfm": "4.0.1"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "esbuild": "0.28.2",
    "typescript": "6.0.3",
    "@deepseek-ai/dsh-client-ui-settings": "0.2.3-alpha.2",
    "@deepseek-ai/dsh-client-ui-sidebar": "0.2.3-alpha.2",
    "@deepseek-ai/dsh-client-ui-slots": "0.2.3-alpha.2",
    "@deepseek-ai/dsh-client-locale": "0.2.3-alpha.2",
    "@types/qrcode": "1.5.6"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dsh-plugins/dsh-concierge-ui.git"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@dsh-plugin/dsh-loader",
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-locale"
      ],
      "external": ["@dsh-plugin/dsh-loader/client"]
    }
  }
}
