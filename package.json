  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "4.2.0-alpha.1",
    "@deepseek-ai/dsh-host-webserver": "0.2.3-alpha.2",
    "@dsh-prism/dsh-orchestrator": "0.1.0"
  },
  "scripts": {
    "build": "tsc -b && npm run bundle",
    "bundle": "node scripts/bundle.mjs"
  },
  "dependencies": {
    "@arco-design/web-react": "2.66.18",
    "@deepseek-ai/dsh-client-ui-theme": "0.2.3-alpha.2",
    "@dsh-plugin/dsh-loader": "2.0.0-dev.45752173879",
    "@dsh-plugin/dsh-ui-components": "next",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "esbuild": "0.28.2"
  }
